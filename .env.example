# Copy to .env and fill in. docker-compose.yml reads .env into admin-migrate
# and admin-api. An empty value counts as unset, so the app refuses to start
# until the required ones are filled in.

# Required.
# Inside Docker the host is the compose service name, admin-postgres:5432.
# From the Mac (e.g. running alembic by hand) use localhost:5434 instead.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@admin-postgres:5432/madras_admin_local
# At least 32 characters; generate one with: openssl rand -hex 32
SECRET_KEY=

# Optional; the values shown are the defaults.
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=720
# CORS_ORIGINS=http://localhost:3000
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_CONNECTION_TIMEOUT=5
# BCRYPT_ROUNDS=12
